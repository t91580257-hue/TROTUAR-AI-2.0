# ============================================================
# TROTUAR AI 2.0 — переменные окружения.
# Скопируйте этот файл в .env и заполните нужные значения.
# Все ключи хранятся ТОЛЬКО на сервере и никогда не попадают в браузер.
# ============================================================

# Порт сервера TROTUAR AI
PORT=3000

# --- Текстовый ИИ: Ollama Cloud (автоматическое подключение) ---
# Приложение подключается к облаку с backend-сервера; локальный Ollama не нужен.
OLLAMA_URL=https://ollama.com
OLLAMA_MODEL=gemma4:31b
# Обязательно задайте секрет OLLAMA_API_KEY в панели хостинга.
# Не вставляйте реальный ключ в этот файл и не отправляйте его в браузер.
OLLAMA_API_KEY=

# Таймаут ответа Ollama в миллисекундах
OLLAMA_TIMEOUT_MS=300000

# Системный промпт (можно переопределить в настройках приложения)
SYSTEM_PROMPT=Ты TROTUAR AI — дружелюбный и умный ассистент. Отвечай на языке пользователя. Используй Markdown.

# --- Резервный провайдер Google Gemini (из версии 1.x, необязательно) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Изображения: Pollinations ---
# ГЕНЕРАЦИЯ работает бесплатно БЕЗ ключа (проверено, лимит ~1 запрос / 45 сек).
# Ключ нужен ТОЛЬКО для редактирования фотографий (image-to-image):
# получите на https://enter.pollinations.ai
POLLINATIONS_API_KEY=
POLLINATIONS_EDIT_MODEL=openai/gpt-image-1-mini

# --- Безопасность / лимиты ---
# Максимальный размер загружаемого файла в МБ
MAX_UPLOAD_MB=15
# Лимиты запросов в минуту на один IP
RATE_LIMIT_CHAT=20
RATE_LIMIT_IMAGE=6
